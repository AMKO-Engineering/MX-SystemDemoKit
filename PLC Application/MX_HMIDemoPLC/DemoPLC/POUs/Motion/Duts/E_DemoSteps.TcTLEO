  <EnumerationTextList Name="E_DemoSteps" Id="{0671ffe1-50d9-495d-9c36-726e942ab046}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_DemoSteps :
(
	Idle := 0,
	MoveToHomePos,
	WaitForhoming,
	CheckForManualCommand,
	ECGModeInit, // the goal is to display a ECG (ElectroCardioGram, or heartbeat signal)   
		ECG_P1,
		ECG_P2,
		ECG_PRSegment,
		ECG_Q,
		ECG_R,
		ECG_S1,
		ECG_S2,
		Ecg_STSegment,
		ECG_T1,
		ECG_T2,
		ECG_Idle,
		ECG_Finish,
	ManualModeInit,
	ManualMode,
	ManualIdle,
	Error
);
END_TYPE
]]></Declaration>
