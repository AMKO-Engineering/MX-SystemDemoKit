      <div id="TcHmiTextblock_4" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-height-unit="px" data-tchmi-left="0" data-tchmi-left-unit="%" data-tchmi-text="The MO7221-9016-1114  24 V servdrive up to 8 A 
Integration of STO/SS1 functions and TwinSAFE Logic. 
Encoder is integrated via an absolute value interface. 
One Cable Technology (OCT), 
The encoder cable is omitted thanks to the signals being transmitted digitally via a B17 motor cable." data-tchmi-top="0" data-tchmi-top-unit="%" data-tchmi-width-unit="px" data-tchmi-word-wrap="True" data-tchmi-right="0" data-tchmi-right-unit="%" data-tchmi-bottom-unit="%" data-tchmi-bottom="0" data-tchmi-text-font-size="150" data-tchmi-text-font-size-unit="%">
</div>
<div id="RectangularButtonWithFeedback_1" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-displaytext="Start manual mode" data-tchmi-height-unit="%" data-tchmi-left="10" data-tchmi-left-unit="%" data-tchmi-target-user-control="Pages/MXDemo/Modules/General/RectangularButtonWithFeedback.usercontrol" data-tchmi-top="80" data-tchmi-top-unit="%" data-tchmi-width-unit="%" data-tchmi-right="55" data-tchmi-right-unit="%" data-tchmi-bottom="5" data-tchmi-bottom-unit="%" data-tchmi-buttonvariable="%s%bCmdStartManualMotionControl%/s%" data-tchmi-feedbackvariable="%s%bManualMotionAcitve%/s%">
<script data-tchmi-target-attribute="data-tchmi-feedbackcollour" type="application/json">
{
  "color": "rgba(51, 246, 3, 1)"
}
</script>

</div>
<div id="TcHmiButton_4" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-height-unit="%" data-tchmi-left="55" data-tchmi-left-unit="%" data-tchmi-text="Button" data-tchmi-top="80" data-tchmi-top-unit="%" data-tchmi-width-unit="%" data-tchmi-word-wrap="True" data-tchmi-right="10" data-tchmi-right-unit="%" data-tchmi-bottom="5" data-tchmi-bottom-unit="%" data-tchmi-state-symbol="%s%bCmdStopDemoMotion%/s%">

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%s%bDemoMotionActive%/s%",
    "actions": [
      {
        "objectType": "Condition",
        "active": true,
        "parts": [
          {
            "if": [
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "symbolExpression": "%s%bDemoMotionActive%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": false
                },
                "compareOperator": "==",
                "logic": null
              }
            ],
            "then": [
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%ctx%owner::Text%/ctx%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/String",
                  "value": "Start demo"
                },
                "asyncWait": true
              }
            ]
          },
          {
            "else": [
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%ctx%owner::Text%/ctx%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/String",
                  "value": "Stop demo"
                },
                "asyncWait": true
              }
            ]
          }
        ],
        "asyncWait": true
      }
    ]
  }
]
</script>
</div>
</div>

